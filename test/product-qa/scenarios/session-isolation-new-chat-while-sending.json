{
  "id": "session-isolation-new-chat-while-sending",
  "name": "새 대화 중 이전 응답 보존과 세션 격리",
  "description": "세션 A에 메시지를 보낸 뒤 응답이 오기 전에 세션 B를 열고, A로 돌아왔을 때 응답·메시지가 유실되거나 섞이지 않는지 검사합니다.",
  "mode": "live",
  "tags": ["session", "chat", "concurrency", "defect-hunt"],
  "covers": ["session:new-while-sending"],
  "timeoutMs": 240000,
  "steps": [
    { "action": "newChat", "label": "sessionA" },
    {
      "action": "sendMessage",
      "label": "sessionA",
      "waitForReply": false,
      "text": "QA_SESSION_A: 답변에 반드시 SESSION_A_OK 라는 문구만 포함해줘. 한 문장으로."
    },
    { "action": "waitMs", "ms": 600 },
    { "action": "newChat", "label": "sessionB" },
    {
      "action": "sendMessage",
      "label": "sessionB",
      "text": "QA_SESSION_B: 답변에 반드시 SESSION_B_OK 라는 문구만 포함해줘. 한 문장으로."
    },
    { "action": "waitForAssistantReply", "timeoutMs": 180000 },
    { "action": "switchSession", "label": "sessionA" },
    { "action": "waitForAssistantReply", "timeoutMs": 180000, "optional": true },
    { "check": "userMessagePresent", "text": "QA_SESSION_A", "severity": "critical" },
    { "check": "assistantMessageContains", "text": "SESSION_A_OK", "severity": "critical" },
    { "check": "noCrossSessionBleed", "forbiddenInSession": "sessionA", "text": "SESSION_B_OK", "severity": "critical" },
    { "check": "sessionCountAtLeast", "min": 2, "severity": "major" },
    { "action": "switchSession", "label": "sessionB" },
    { "check": "assistantMessageContains", "text": "SESSION_B_OK", "severity": "critical" },
    { "action": "screenshot", "name": "final" }
  ]
}
