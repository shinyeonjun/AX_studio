{
  "id": "one-shot-legacy-approval",
  "name": "Generic legacy workflow approval approve",
  "description": "A continuation excludes the final-action editor; retain real legacy approval-card coverage.",
  "mode": "deterministic",
  "tags": [
    "chat",
    "approval",
    "deterministic"
  ],
  "covers": [
    "runtime:approvals-activity"
  ],
  "timeoutMs": 120000,
  "steps": [
    {
      "action": "newChat"
    },
    {
      "action": "sendMessage",
      "text": "__e2e:legacy-approval__"
    },
    {
      "check": "inlineApprovalPresent"
    },
    {
      "check": "visibleTextContains",
      "text": "외부 작업 전 확인"
    },
    {
      "check": "syntheticSlackEvidence",
      "sends": 0,
      "status": "pending_approval",
      "legacy": true
    },
    {
      "action": "clickInlineApproval",
      "decision": "approve"
    },
    {
      "check": "inlineApprovalAbsent"
    },
    {
      "check": "visibleTextContains",
      "text": "실행 완료"
    },
    {
      "check": "syntheticSlackEvidence",
      "sends": 1,
      "status": "success",
      "legacy": true,
      "params": {
        "channel": "#e2e",
        "text": "E2E approval test"
      },
      "literal": false
    },
    {
      "check": "composerEnabled",
      "severity": "major"
    }
  ]
}
