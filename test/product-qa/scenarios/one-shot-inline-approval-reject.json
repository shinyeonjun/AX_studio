{
  "id": "one-shot-inline-approval-reject",
  "name": "One-shot Slack editor cancellation",
  "description": "Review the complete verified Slack draft and cancel twice through UI; no connector invocation is allowed.",
  "mode": "deterministic",
  "tags": [
    "chat",
    "approval",
    "deterministic"
  ],
  "covers": [
    "runtime:approvals-activity"
  ],
  "timeoutMs": 120000,
  "steps": [
    {
      "action": "setViewport",
      "width": 1280,
      "height": 873
    },
    {
      "action": "newChat",
      "label": "inline-approval"
    },
    {
      "action": "sendMessage",
      "text": "__e2e:inline-approval__"
    },
    {
      "check": "assistantMessageContains",
      "text": "E2E inline_approval_queued"
    },
    {
      "check": "slackDraft",
      "channel": "#e2e",
      "text": "E2E approval test"
    },
    {
      "check": "syntheticSlackEvidence",
      "sends": 0,
      "status": "pending_approval"
    },
    {
      "action": "clickSlackResult",
      "control": "review"
    },
    {
      "check": "slackReview",
      "channelId": "C12345678",
      "channelLabel": "#e2e",
      "text": "E2E approval test"
    },
    {
      "check": "syntheticSlackEvidence",
      "sends": 0,
      "status": "pending_approval"
    },
    {
      "action": "screenshot",
      "name": "slack-before-cancel",
      "scale": "css"
    },
    {
      "action": "clickSlackResult",
      "control": "cancel",
      "repeat": true
    },
    {
      "check": "slackTerminal",
      "decision": "cancelled"
    },
    {
      "check": "syntheticSlackEvidence",
      "sends": 0,
      "status": "cancelled"
    },
    {
      "action": "waitMs",
      "ms": 500
    },
    {
      "check": "syntheticSlackEvidence",
      "sends": 0,
      "status": "cancelled"
    },
    {
      "action": "screenshot",
      "name": "slack-cancelled",
      "scale": "css"
    },
    {
      "check": "composerEnabled",
      "severity": "major"
    }
  ]
}
