{
  "name": "ax-studio",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @ax-studio/core && npm run build -w @ax-studio/desktop",
    "test": "npm run test:manual:webhook:security && npm run test -w @ax-studio/core --",
    "test:e2e": "node test/e2e/run.mjs",
    "test:product-qa": "node test/product-qa/run.mjs",
    "test:integration": "node test/integration/run.mjs",
    "test:manual": "node test/manual/start.mjs",
    "test:manual:http": "node test/manual/rest-api.mjs",
    "test:manual:db": "node test/manual/postgres.mjs",
    "test:manual:webhook": "node test/manual/webhook.mjs",
    "test:manual:webhook:security": "node --test test/manual/webhook.test.mjs",
    "eval": "npm run eval -w @ax-studio/core",
    "knip": "knip",
    "arch:check": "depcruise packages/core/src --config .dependency-cruiser.cjs --output-type err",
    "ax": "node packages/core/dist/agent/commands/cli.js",
    "dev": "npm run dev -w @ax-studio/desktop",
    "dev:poc": "npm run dev:poc -w @ax-studio/desktop",
    "document-engine:setup": "python -m venv packages/document-engine/.venv && npm run document-engine:install",
    "document-engine:install": "node scripts/document-engine-install.mjs",
    "document-engine:install:docling": "node scripts/document-engine-install.mjs --docling"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@34.5.8": true,
    "better-sqlite3@11.10.0": true
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "dependency-cruiser": "^18.2.0",
    "knip": "^6.32.2"
  }
}
