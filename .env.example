# 개발용 — 복사해서 .env 로 저장하세요 (커밋하지 않음)
CURSOR_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gmail OAuth (앱 내장 — 일반 사용자는 Cloud Console 설정 불필요)
# Google Cloud Console에서 Desktop OAuth 클라이언트 1개만 만들고 Client ID를 넣으세요.
# Redirect URI: http://127.0.0.1:<random-port>/oauth/callback (랜덤 loopback 포트 사용)
# Client Secret은 Desktop 앱에서 필수는 아닙니다 (PKCE 사용).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
