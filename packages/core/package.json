{
  "name": "@ax-studio/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "ax": "./dist/agent/commands/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai-catalog": {
      "types": "./dist/agent/settings/ai-catalog.d.ts",
      "import": "./dist/agent/settings/ai-catalog.js",
      "default": "./dist/agent/settings/ai-catalog.js"
    },
    "./catalog-data": {
      "types": "./dist/modules/packages/catalog-data.d.ts",
      "import": "./dist/modules/packages/catalog-data.js",
      "default": "./dist/modules/packages/catalog-data.js"
    },
    "./interview-constants": {
      "types": "./dist/interview/compile/constants.d.ts",
      "import": "./dist/interview/compile/constants.js",
      "default": "./dist/interview/compile/constants.js"
    },
    "./panel-fields": {
      "types": "./dist/interview/presentation/panel-fields.d.ts",
      "import": "./dist/interview/presentation/panel-fields.js",
      "default": "./dist/interview/presentation/panel-fields.js"
    },
    "./visual-display": {
      "types": "./dist/workflow/visual-display.d.ts",
      "import": "./dist/workflow/visual-display.js",
      "default": "./dist/workflow/visual-display.js"
    }
  },
  "scripts": {
    "build": "node scripts/embed-skills.mjs && tsc",
    "test": "node scripts/embed-skills.mjs && vitest run",
    "eval": "node scripts/embed-skills.mjs && vitest run --config vitest.eval.config.ts",
    "typecheck": "node scripts/embed-skills.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^0.2.0",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^7.8.0",
    "@types/sql.js": "^1.4.11",
    "ai": "^4.3.0",
    "better-sqlite3": "^11.10.0",
    "docxtemplater": "^3.55.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "handlebars": "^4.7.8",
    "pg": "^8.13.3",
    "pizzip": "^3.1.8",
    "sql.js": "^1.14.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
