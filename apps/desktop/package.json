{
  "name": "@ax-studio/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "ensure:native": "node scripts/ensure-native-db.mjs",
    "dev": "node scripts/ensure-native-db.mjs && electron-vite dev",
    "dev:poc": "node ../../scripts/desktop-dev-poc.mjs",
    "dev:kill": "taskkill /F /IM electron.exe /T 2>nul & exit 0",
    "dev:restart": "npm run dev:kill && npm run dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "pack:win": "npm run build && electron-builder --win",
    "rebuild:native": "node scripts/ensure-native-db.mjs",
    "postinstall": "node scripts/ensure-native-db.mjs"
  },
  "build": {
    "extends": "./electron-builder.yml"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.16",
    "@ax-studio/core": "*",
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.11.3",
    "better-sqlite3": "^11.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
