{
  "name": "@ax-studio/desktop",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Local AI work execution app",
  "author": "AX Studio",
  "main": "out/main/index.js",
  "scripts": {
    "ensure:native": "node scripts/ensure-native-db.mjs",
    "dev": "node ../../scripts/desktop-dev-poc.mjs",
    "dev:raw": "node scripts/ensure-native-db.mjs && install-electron && electron-vite dev",
    "dev:poc": "node ../../scripts/desktop-dev-poc.mjs --poc",
    "dev:kill": "taskkill /F /IM electron.exe /T 2>nul & exit 0",
    "dev:restart": "npm run dev:kill && npm run dev",
    "build": "electron-vite build",
    "test": "vitest run electron src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "electron-vite preview",
    "pack": "node scripts/package-desktop.mjs --dir",
    "pack:win": "node scripts/package-desktop.mjs --platform=win32",
    "rebuild:native": "node scripts/ensure-native-db.mjs",
    "postinstall": "node scripts/ensure-native-db.mjs",
    "pack:linux": "node scripts/package-desktop.mjs --platform=linux",
    "pack:linux:build": "node scripts/package-desktop.mjs --platform=linux --skip-ui"
  },
  "build": {
    "extends": "./electron-builder.yml"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.25",
    "@ax-studio/core": "*",
    "@dagrejs/dagre": "^3.1.1",
    "@googleapis/gmail": "^22.0.1",
    "@slack/socket-mode": "^3.1.0",
    "@slack/web-api": "^7.8.0",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "6.8.9",
    "google-auth-library": "^11.2.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.2",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.3"
  }
}
